<Window x:Class="EcoHub.Admin.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:EcoHub.Admin"
        xmlns:views="clr-namespace:EcoHub.Admin.Views"
        mc:Ignorable="d"
        Title="EcoHub Admin" Height="740" Width="1180"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource EhBgBrush}"
        FontFamily="Segoe UI">
    <Grid>
        <Grid x:Name="MainContent" Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="240"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="64"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Top Bar -->
            <Border Grid.ColumnSpan="2" Background="{StaticResource EhHeaderGradient}" Padding="22,0">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="18" ShadowDepth="2" Opacity="0.22" Color="#FF0D3D10" />
                </Border.Effect>
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Viewbox Stretch="Uniform" StretchDirection="DownOnly" MaxHeight="28" Margin="0,0,10,0" VerticalAlignment="Center">
                            <TextBlock Text="&#127807;" FontSize="22" TextWrapping="NoWrap" />
                        </Viewbox>
                        <Viewbox Stretch="Uniform" StretchDirection="DownOnly" MaxHeight="28" VerticalAlignment="Center">
                            <TextBlock Text="EcoHub Admin" Foreground="White" FontSize="19" FontWeight="Bold" TextWrapping="NoWrap" />
                        </Viewbox>
                        <Border Background="#33FFFFFF" CornerRadius="10" Padding="8,3" Margin="14,0,0,0" VerticalAlignment="Center">
                            <Viewbox Stretch="Uniform" StretchDirection="DownOnly" MaxHeight="16">
                                <TextBlock Text="Control Panel" Foreground="White" FontSize="10.5" FontWeight="SemiBold" TextWrapping="NoWrap" />
                            </Viewbox>
                        </Border>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Border Background="#22FFFFFF" CornerRadius="17" Padding="14,6" Margin="0,0,10,0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Ellipse x:Name="ConnectionIndicator" Width="10" Height="10" Fill="#FFBDBDBD" Margin="0,0,8,0"
                                         RenderTransformOrigin="0.5,0.5">
                                    <Ellipse.RenderTransform>
                                        <ScaleTransform ScaleX="1" ScaleY="1"/>
                                    </Ellipse.RenderTransform>
                                </Ellipse>
                                <TextBlock x:Name="ConnectionText" Text="Disconnected" Foreground="White" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <Button x:Name="NotificationsButton" Content="🔔 Notifications" Click="Notifications_Click"
                                Style="{StaticResource EhTopBarButton}" Margin="0,0,10,0"/>
                        <Border x:Name="NotificationBadge"
                                Background="{StaticResource EhCoralBrush}"
                                CornerRadius="10" Padding="7,1" Margin="-22,-18,10,0"
                                Visibility="Collapsed" VerticalAlignment="Top"
                                RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <ScaleTransform ScaleX="1" ScaleY="1"/>
                            </Border.RenderTransform>
                            <Border.Triggers>
                                <EventTrigger RoutedEvent="Loaded">
                                    <BeginStoryboard Storyboard="{StaticResource EhPulseSoft}" />
                                </EventTrigger>
                            </Border.Triggers>
                            <TextBlock x:Name="NotificationBadgeText" Text="0" Foreground="White" FontSize="10.5" FontWeight="Bold"/>
                        </Border>

                        <Button Content="Logout" Click="Logout_Click" Style="{StaticResource EhTopBarButton}"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Side Menu -->
            <Border Grid.Row="1" Background="{StaticResource EhSideMenuGradient}" BorderBrush="{StaticResource EhInk200Brush}" BorderThickness="0,0,1,0">
                <StackPanel Margin="6,16,6,16">
                    <TextBlock Text="MENU" FontSize="10" FontWeight="Bold" Foreground="{StaticResource EhInk500Brush}" Margin="22,0,0,10" />
                    <Button x:Name="NavDashboardBtn" Content="🏠    Dashboard"   Click="NavDashboard_Click"   Style="{StaticResource EhNavButton}" Tag="Active"/>
                    <Button x:Name="NavUsersBtn"     Content="👥    Users"       Click="NavUsers_Click"       Style="{StaticResource EhNavButton}"/>
                    <Button x:Name="NavProductsBtn"  Content="📦    Products"    Click="NavProducts_Click"    Style="{StaticResource EhNavButton}"/>
                    <Button x:Name="NavCategoriesBtn" Content="🏷    Categories" Click="NavCategories_Click"  Style="{StaticResource EhNavButton}"/>
                    <Button x:Name="NavOrdersBtn"    Content="🧾    Orders"      Click="NavOrders_Click"      Style="{StaticResource EhNavButton}"/>
                    <Button x:Name="NavSettingsBtn"  Content="⚙    Settings"    Click="NavSettings_Click"    Style="{StaticResource EhNavButton}"/>
                </StackPanel>
            </Border>

            <!-- Content Frame -->
            <Frame x:Name="ContentFrame" Grid.Row="1" Grid.Column="1" NavigationUIVisibility="Hidden"
                   Background="{StaticResource EhBgBrush}"/>
        </Grid>

        <!-- Login Overlay -->
        <views:LoginView x:Name="LoginView" Visibility="Visible" LoginSuccess="LoginView_LoginSuccess"/>
    </Grid>
</Window>
