<UserControl x:Class="EcoHub.Admin.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             Background="{StaticResource EhBgBrush}"
             d:DesignHeight="650" d:DesignWidth="940">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="28,26,28,32" Opacity="0">
            <StackPanel.RenderTransform>
                <TranslateTransform Y="0"/>
            </StackPanel.RenderTransform>
            <StackPanel.Triggers>
                <EventTrigger RoutedEvent="Loaded">
                    <BeginStoryboard Storyboard="{StaticResource EhFadeInUp}"/>
                </EventTrigger>
            </StackPanel.Triggers>

            <!-- Page header -->
            <StackPanel Margin="0,0,0,24">
                <TextBlock Text="Dashboard" FontSize="28" FontWeight="Bold" Foreground="{StaticResource EhInk900Brush}"/>
                <TextBlock Text="Overview of your store activity" Foreground="{StaticResource EhInk500Brush}" Margin="0,4,0,0"/>
            </StackPanel>

            <!-- Stat cards -->
            <WrapPanel Margin="0,0,0,18">
                <!-- Total Users -->
                <Border Style="{StaticResource EhStatCard}" Opacity="0">
                    <Border.RenderTransform>
                        <TranslateTransform Y="0"/>
                    </Border.RenderTransform>
                    <Border.Triggers>
                        <EventTrigger RoutedEvent="Loaded">
                            <BeginStoryboard Storyboard="{StaticResource EhFadeInUp_100}"/>
                        </EventTrigger>
                    </Border.Triggers>
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Border Background="{StaticResource EhGreen50Brush}" CornerRadius="10" Padding="8" Width="36" Height="36">
                                <TextBlock Text="👥" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="Total Users" FontWeight="SemiBold" FontSize="12.5"
                                       Foreground="{StaticResource EhInk500Brush}" VerticalAlignment="Center" Margin="10,0,0,0"/>
                        </StackPanel>
                        <TextBlock x:Name="TotalUsersText" FontSize="32" FontWeight="Bold"
                                   Foreground="{StaticResource EhGreen700Brush}" Margin="0,12,0,0"/>
                    </StackPanel>
                </Border>

                <!-- New Users -->
                <Border Style="{StaticResource EhStatCard}" Opacity="0">
                    <Border.RenderTransform>
                        <TranslateTransform Y="0"/>
                    </Border.RenderTransform>
                    <Border.Triggers>
                        <EventTrigger RoutedEvent="Loaded">
                            <BeginStoryboard Storyboard="{StaticResource EhFadeInUp_200}"/>
                        </EventTrigger>
                    </Border.Triggers>
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Border Background="#FFFFF3E0" CornerRadius="10" Padding="8" Width="36" Height="36">
                                <TextBlock Text="✨" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="New Users" FontWeight="SemiBold" FontSize="12.5"
                                       Foreground="{StaticResource EhInk500Brush}" VerticalAlignment="Center" Margin="10,0,0,0"/>
                        </StackPanel>
                        <TextBlock x:Name="NewUsersText" FontSize="32" FontWeight="Bold"
                                   Foreground="#FFFF8A00" Margin="0,12,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Total Orders -->
                <Border Style="{StaticResource EhStatCard}" Opacity="0">
                    <Border.RenderTransform>
                        <TranslateTransform Y="0"/>
                    </Border.RenderTransform>
                    <Border.Triggers>
                        <EventTrigger RoutedEvent="Loaded">
                            <BeginStoryboard Storyboard="{StaticResource EhFadeInUp_300}"/>
                        </EventTrigger>
                    </Border.Triggers>
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Border Background="#FFE3F2FD" CornerRadius="10" Padding="8" Width="36" Height="36">
                                <TextBlock Text="🧾" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="Total Orders" FontWeight="SemiBold" FontSize="12.5"
                                       Foreground="{StaticResource EhInk500Brush}" VerticalAlignment="Center" Margin="10,0,0,0"/>
                        </StackPanel>
                        <TextBlock x:Name="TotalOrdersText" FontSize="32" FontWeight="Bold"
                                   Foreground="#FF1565C0" Margin="0,12,0,0"/>
                    </StackPanel>
                </Border>

                <!-- New Orders -->
                <Border Style="{StaticResource EhStatCard}" Opacity="0">
                    <Border.RenderTransform>
                        <TranslateTransform Y="0"/>
                    </Border.RenderTransform>
                    <Border.Triggers>
                        <EventTrigger RoutedEvent="Loaded">
                            <BeginStoryboard Storyboard="{StaticResource EhFadeInUp_400}"/>
                        </EventTrigger>
                    </Border.Triggers>
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Border Background="#FFFCE4EC" CornerRadius="10" Padding="8" Width="36" Height="36">
                                <TextBlock Text="🔥" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="New Orders" FontWeight="SemiBold" FontSize="12.5"
                                       Foreground="{StaticResource EhInk500Brush}" VerticalAlignment="Center" Margin="10,0,0,0"/>
                        </StackPanel>
                        <TextBlock x:Name="NewOrdersText" FontSize="32" FontWeight="Bold"
                                   Foreground="#FFC2185B" Margin="0,12,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Revenue -->
                <Border Style="{StaticResource EhStatCard}" Opacity="0">
                    <Border.RenderTransform>
                        <TranslateTransform Y="0"/>
                    </Border.RenderTransform>
                    <Border.Triggers>
                        <EventTrigger RoutedEvent="Loaded">
                            <BeginStoryboard Storyboard="{StaticResource EhFadeInUp_500}"/>
                        </EventTrigger>
                    </Border.Triggers>
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Border Background="#FFF3E5F5" CornerRadius="10" Padding="8" Width="36" Height="36">
                                <TextBlock Text="💰" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="Revenue" FontWeight="SemiBold" FontSize="12.5"
                                       Foreground="{StaticResource EhInk500Brush}" VerticalAlignment="Center" Margin="10,0,0,0"/>
                        </StackPanel>
                        <TextBlock x:Name="RevenueText" FontSize="32" FontWeight="Bold"
                                   Foreground="#FF6A1B9A" Margin="0,12,0,0"/>
                    </StackPanel>
                </Border>
            </WrapPanel>

            <!-- Low Stock -->
            <Border Style="{StaticResource EhCard}" Margin="0,10,0,18">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                        <TextBlock Text="⚠" FontSize="18" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="Low Stock Products" Style="{StaticResource EhH2}"/>
                    </StackPanel>
                    <DataGrid x:Name="LowStockGrid" Style="{StaticResource EhDataGrid}"
                              AutoGenerateColumns="False" IsReadOnly="True" Height="160">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="60"/>
                            <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*"/>
                            <DataGridTextColumn Header="Stock" Binding="{Binding StockQuantity}" Width="90"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </Border>

            <!-- Top selling -->
            <Border Style="{StaticResource EhCard}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                        <TextBlock Text="🏆" FontSize="18" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="Top Selling Products" Style="{StaticResource EhH2}"/>
                    </StackPanel>
                    <DataGrid x:Name="TopProductsGrid" Style="{StaticResource EhDataGrid}"
                              AutoGenerateColumns="False" IsReadOnly="True" Height="220">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="60"/>
                            <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*"/>
                            <DataGridTextColumn Header="Total Sold" Binding="{Binding TotalSold}" Width="110"/>
                            <DataGridTextColumn Header="Revenue" Binding="{Binding TotalRevenue, StringFormat={}{0:N2} MDL}" Width="150"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
