<Window x:Class="EcoHub.Admin.Views.ProductDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Product"
        Height="660" Width="500"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize">
    <Border CornerRadius="16"
            Background="{StaticResource EhSurfaceBrush}"
            Effect="{StaticResource EhShadowLg}"
            Margin="16">
        <Border.RenderTransform>
            <ScaleTransform ScaleX="0.95" ScaleY="0.95" CenterX="215" CenterY="260"/>
        </Border.RenderTransform>
        <Border.Triggers>
            <EventTrigger RoutedEvent="Loaded">
                <BeginStoryboard Storyboard="{StaticResource EhScaleIn}"/>
            </EventTrigger>
        </Border.Triggers>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header with gradient -->
            <Border Grid.Row="0"
                    Background="{StaticResource EhHeaderGradient}"
                    CornerRadius="16,16,0,0"
                    Padding="24,18"
                    MouseLeftButtonDown="Header_MouseDown">
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="📦" FontSize="22" Margin="0,0,10,0" VerticalAlignment="Center"/>
                        <StackPanel>
                            <TextBlock x:Name="DialogTitle" Text="Product" FontSize="18" FontWeight="Bold" Foreground="White"/>
                            <TextBlock Text="Manage product details" FontSize="11" Foreground="#CFE9D1"/>
                        </StackPanel>
                    </StackPanel>
                    <Button Content="✕"
                            HorizontalAlignment="Right"
                            Width="32" Height="32"
                            Background="Transparent"
                            BorderThickness="0"
                            Foreground="White"
                            FontSize="16"
                            Cursor="Hand"
                            Click="Cancel_Click"/>
                </Grid>
            </Border>

            <!-- Form -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="28,20,28,10">
                <StackPanel>
                    <TextBlock Text="Name" Style="{StaticResource EhLabel}" Margin="0,0,0,6"/>
                    <TextBox x:Name="NameBox" Style="{StaticResource EhTextBox}"
                             TextWrapping="Wrap" AcceptsReturn="False" Margin="0,0,0,14"/>

                    <TextBlock Text="Description" Style="{StaticResource EhLabel}" Margin="0,0,0,6"/>
                    <TextBox x:Name="DescriptionBox" Style="{StaticResource EhTextBox}"
                             MinHeight="90" AcceptsReturn="True" TextWrapping="Wrap"
                             VerticalContentAlignment="Top" Margin="0,0,0,14"/>

                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Price (MDL)" Style="{StaticResource EhLabel}" Margin="0,0,0,6"/>
                            <TextBox x:Name="PriceBox" Style="{StaticResource EhTextBox}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Stock" Style="{StaticResource EhLabel}" Margin="0,0,0,6"/>
                            <TextBox x:Name="StockBox" Style="{StaticResource EhTextBox}"/>
                        </StackPanel>
                    </Grid>

                    <Grid Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Category ID" Style="{StaticResource EhLabel}" Margin="0,0,0,6"/>
                            <TextBox x:Name="CategoryBox" Style="{StaticResource EhTextBox}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Discount %" Style="{StaticResource EhLabel}" Margin="0,0,0,6"/>
                            <TextBox x:Name="DiscountBox" Style="{StaticResource EhTextBox}"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </ScrollViewer>

            <!-- Footer -->
            <Border Grid.Row="2"
                    Background="#F6FAF6"
                    CornerRadius="0,0,16,16"
                    Padding="24,16"
                    BorderBrush="#E4ECE5"
                    BorderThickness="0,1,0,0">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Cancel"
                            Click="Cancel_Click"
                            Style="{StaticResource EhOutlineButton}"
                            Margin="0,0,10,0"/>
                    <Button Content="💾 Save"
                            Click="Save_Click"
                            Style="{StaticResource EhPrimaryButton}"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
