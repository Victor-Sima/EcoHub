<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- =========================================================
         Reusable Storyboards
         Use: <Border.Triggers><EventTrigger RoutedEvent="Loaded">
                <BeginStoryboard Storyboard="{StaticResource EhFadeInUp}"/>
              </EventTrigger></Border.Triggers>
         For Storyboard.TargetProperty we rely on attached properties
         of the element; see per-view usage.
         ========================================================= -->

    <!-- Simple fade-in -->
    <Storyboard x:Key="EhFadeIn">
        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                         From="0" To="1" Duration="0:0:0.45" />
    </Storyboard>

    <!-- Page slide-up fade-in (target must have a TranslateTransform) -->
    <Storyboard x:Key="EhFadeInUp">
        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                         From="0" To="1" Duration="0:0:0.55" />
        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                         From="28" To="0" Duration="0:0:0.55">
            <DoubleAnimation.EasingFunction>
                <CubicEase EasingMode="EaseOut" />
            </DoubleAnimation.EasingFunction>
        </DoubleAnimation>
    </Storyboard>

    <Storyboard x:Key="EhFadeInDown">
        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                         From="0" To="1" Duration="0:0:0.55" />
        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                         From="-28" To="0" Duration="0:0:0.55">
            <DoubleAnimation.EasingFunction>
                <CubicEase EasingMode="EaseOut" />
            </DoubleAnimation.EasingFunction>
        </DoubleAnimation>
    </Storyboard>

    <Storyboard x:Key="EhSlideInLeft">
        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                         From="0" To="1" Duration="0:0:0.5" />
        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                         From="-40" To="0" Duration="0:0:0.55">
            <DoubleAnimation.EasingFunction>
                <CubicEase EasingMode="EaseOut" />
            </DoubleAnimation.EasingFunction>
        </DoubleAnimation>
    </Storyboard>

    <Storyboard x:Key="EhSlideInRight">
        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                         From="0" To="1" Duration="0:0:0.5" />
        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                         From="40" To="0" Duration="0:0:0.55">
            <DoubleAnimation.EasingFunction>
                <CubicEase EasingMode="EaseOut" />
            </DoubleAnimation.EasingFunction>
        </DoubleAnimation>
    </Storyboard>

    <!-- Scale-in (zoom). Target must have a ScaleTransform(1,1) -->
    <Storyboard x:Key="EhScaleIn">
        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                         From="0" To="1" Duration="0:0:0.5" />
        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                         From="0.9" To="1" Duration="0:0:0.5">
            <DoubleAnimation.EasingFunction>
                <BackEase EasingMode="EaseOut" Amplitude="0.25" />
            </DoubleAnimation.EasingFunction>
        </DoubleAnimation>
        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                         From="0.9" To="1" Duration="0:0:0.5">
            <DoubleAnimation.EasingFunction>
                <BackEase EasingMode="EaseOut" Amplitude="0.25" />
            </DoubleAnimation.EasingFunction>
        </DoubleAnimation>
    </Storyboard>

    <!-- Soft pulse (infinite) for highlighting badges -->
    <Storyboard x:Key="EhPulseSoft" RepeatBehavior="Forever" AutoReverse="True">
        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                         From="1" To="1.08" Duration="0:0:1.2">
            <DoubleAnimation.EasingFunction>
                <SineEase EasingMode="EaseInOut" />
            </DoubleAnimation.EasingFunction>
        </DoubleAnimation>
        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                         From="1" To="1.08" Duration="0:0:1.2">
            <DoubleAnimation.EasingFunction>
                <SineEase EasingMode="EaseInOut" />
            </DoubleAnimation.EasingFunction>
        </DoubleAnimation>
    </Storyboard>

    <!-- Floating up/down (infinite) -->
    <Storyboard x:Key="EhFloat" RepeatBehavior="Forever" AutoReverse="True">
        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                         From="0" To="-8" Duration="0:0:1.8">
            <DoubleAnimation.EasingFunction>
                <SineEase EasingMode="EaseInOut" />
            </DoubleAnimation.EasingFunction>
        </DoubleAnimation>
    </Storyboard>

    <!-- Status dot blinking -->
    <Storyboard x:Key="EhBlink" RepeatBehavior="Forever" AutoReverse="True">
        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                         From="1" To="0.35" Duration="0:0:0.9">
            <DoubleAnimation.EasingFunction>
                <SineEase EasingMode="EaseInOut" />
            </DoubleAnimation.EasingFunction>
        </DoubleAnimation>
    </Storyboard>

    <!-- Rotate spinner 360 (infinite) -->
    <Storyboard x:Key="EhSpin" RepeatBehavior="Forever">
        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                         From="0" To="360" Duration="0:0:1.0" />
    </Storyboard>

    <!-- Staggered delayed fade-ups (combine with delay via BeginTime) -->
    <Storyboard x:Key="EhFadeInUp_100">
        <DoubleAnimation BeginTime="0:0:0.1" Storyboard.TargetProperty="Opacity"
                         From="0" To="1" Duration="0:0:0.5" />
        <DoubleAnimation BeginTime="0:0:0.1" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                         From="22" To="0" Duration="0:0:0.5">
            <DoubleAnimation.EasingFunction>
                <CubicEase EasingMode="EaseOut" />
            </DoubleAnimation.EasingFunction>
        </DoubleAnimation>
    </Storyboard>

    <Storyboard x:Key="EhFadeInUp_200">
        <DoubleAnimation BeginTime="0:0:0.2" Storyboard.TargetProperty="Opacity"
                         From="0" To="1" Duration="0:0:0.5" />
        <DoubleAnimation BeginTime="0:0:0.2" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                         From="22" To="0" Duration="0:0:0.5">
            <DoubleAnimation.EasingFunction>
                <CubicEase EasingMode="EaseOut" />
            </DoubleAnimation.EasingFunction>
        </DoubleAnimation>
    </Storyboard>

    <Storyboard x:Key="EhFadeInUp_300">
        <DoubleAnimation BeginTime="0:0:0.3" Storyboard.TargetProperty="Opacity"
                         From="0" To="1" Duration="0:0:0.5" />
        <DoubleAnimation BeginTime="0:0:0.3" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                         From="22" To="0" Duration="0:0:0.5">
            <DoubleAnimation.EasingFunction>
                <CubicEase EasingMode="EaseOut" />
            </DoubleAnimation.EasingFunction>
        </DoubleAnimation>
    </Storyboard>

    <Storyboard x:Key="EhFadeInUp_400">
        <DoubleAnimation BeginTime="0:0:0.4" Storyboard.TargetProperty="Opacity"
                         From="0" To="1" Duration="0:0:0.5" />
        <DoubleAnimation BeginTime="0:0:0.4" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                         From="22" To="0" Duration="0:0:0.5">
            <DoubleAnimation.EasingFunction>
                <CubicEase EasingMode="EaseOut" />
            </DoubleAnimation.EasingFunction>
        </DoubleAnimation>
    </Storyboard>

    <Storyboard x:Key="EhFadeInUp_500">
        <DoubleAnimation BeginTime="0:0:0.5" Storyboard.TargetProperty="Opacity"
                         From="0" To="1" Duration="0:0:0.5" />
        <DoubleAnimation BeginTime="0:0:0.5" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                         From="22" To="0" Duration="0:0:0.5">
            <DoubleAnimation.EasingFunction>
                <CubicEase EasingMode="EaseOut" />
            </DoubleAnimation.EasingFunction>
        </DoubleAnimation>
    </Storyboard>

</ResourceDictionary>
