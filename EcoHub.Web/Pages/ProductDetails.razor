@page "/product/{id:int}"
@inject HttpClient Http
@inject AuthService AuthService
@inject NavigationManager Navigation

<PageTitle>Product Details - EcoHub</PageTitle>

@if (product == null)
{
    <div class="container py-5 text-center">
        <p class="text-muted">Loading product details...</p>
    </div>
}
else
{
    <div class="container py-5">
        <a href="/products" class="btn btn-eco-outline mb-4">&#8592; Back to Products</a>

        <div class="card border-0 shadow-sm">
            <div class="row g-0">
                <div class="col-md-5">
                    <div class="card-img-placeholder" style="height: 300px; font-size: 5rem;">
                        @if (product.DiscountPercentage > 0)
                        {
                            <span class="discount-badge" style="font-size: 1rem;">-@product.DiscountPercentage%</span>
                        }
                        @if (!string.IsNullOrEmpty(product.ImageUrl))
                        {
                            <img src="@product.ImageUrl" alt="@product.Name" onerror="this.onerror=null;this.src='https://cdn.dummyjson.com/product-images/groceries/apple/thumbnail.webp';" data-pid="@product.Id" />
                        }
                        else
                        {
                            @GetProductEmoji(product.CategoryName)
                        }
                    </div>
                </div>
                <div class="col-md-7 p-4">
                    <div class="product-category mb-2">@product.CategoryName</div>
                    <h3 class="fw-bold mb-2">@product.Name</h3>
                    <p class="text-muted mb-3">@product.Description</p>

                    <div class="product-price-row mb-3">
                        @if (product.DiscountPercentage > 0)
                        {
                            <span class="product-price-original" style="font-size: 1.3rem;">@FormatLei(product.Price)</span>
                            <span class="product-price-discounted" style="font-size: 1.8rem;">@FormatLei(product.DiscountedPrice)</span>
                            <span class="badge bg-danger ms-2">SAVE @(product.DiscountPercentage)%</span>
                        }
                        else
                        {
                            <span class="product-price-regular" style="font-size: 1.8rem;">@FormatLei(product.Price)</span>
                        }
                    </div>

                    <p class="mb-3">
                        <span class="badge @(product.StockQuantity > 0 ? "bg-success" : "bg-danger")">
                            @(product.StockQuantity > 0 ? $"In stock: {product.StockQuantity}" : "Out of stock")
                        </span>
                    </p>

                    <AuthorizeView>
                        <Authorized>
                            @if (product.StockQuantity > 0)
                            {
                                <div class="d-flex gap-3 align-items-center mb-3">
                                    <label class="fw-bold">Quantity:</label>
                                    <input type="number" class="form-control quantity-input" @bind="quantity" min="1" max="@product.StockQuantity" />
                                </div>
                                <button class="btn btn-eco" @onclick="AddToCart">&#128722; Add to Cart</button>
                            }
                            else
                            {
                                <button class="btn btn-secondary" disabled>Out of stock</button>
                            }
                            @if (!string.IsNullOrEmpty(message))
                            {
                                <div class="alert alert-eco mt-3">@message</div>
                            }
                        </Authorized>
                        <NotAuthorized>
                            <a href="/login" class="btn btn-eco-outline">&#128274; Login to purchase</a>
                        </NotAuthorized>
                    </AuthorizeView>
                </div>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public int Id { get; set; }
    private ProductDto? product;
    private int quantity = 1;
    private string? message;

    protected override async Task OnInitializedAsync()
    {
        product = await Http.GetFromJsonAsync<ProductDto>($"api/products/{Id}");
    }

    private async Task AddToCart()
    {
        message = null;
        var token = await AuthService.GetTokenAsync();
        if (string.IsNullOrEmpty(token))
        {
            Navigation.NavigateTo("/login");
            return;
        }

        var response = await Http.PostAsJsonAsync(ApiRoutes.Cart.AddItem, new AddCartItemRequest { ProductId = Id, Quantity = quantity });
        if (response.IsSuccessStatusCode)
        {
            message = "Added to cart!";
        }
        else
        {
            var error = await response.Content.ReadFromJsonAsync<Dictionary<string, string>>();
            message = error?["message"] ?? "Failed to add to cart.";
        }
    }

    private string FormatLei(decimal price) => $"{price:N0} Lei";

    private string GetProductEmoji(string category)
    {
        return category switch
        {
            "Fruits" => "\uD83C\uDF53",
            "Vegetables" => "\uD83E\uDD66",
            "Dairy" => "\uD83E\uDDC0",
            "Bakery" => "\uD83C\uDF5E",
            "Beverages" => "\uD83C\uDF64",
            _ => "\uD83D\uDED2"
        };
    }
}